# Copy this file to `.env` for local development.
#
# IMPORTANT
# - Never commit real secrets to git.
# - Vercel Serverless Functions read variables from Vercel Project Settings → Environment Variables.
# - Vite only exposes variables prefixed with VITE_ to the client.

# ----------------------------
# Client (Vite) variables
# ----------------------------

# Voluntary page sample data control:
# - If set to DEV, the Voluntary page will show sample cards locally.
# - In production, leave unset (or anything other than DEV).
VITE_MODE=DEV


# ----------------------------
# Server (Vercel Functions) variables
# Used by /api/voluntary and /api/booking
# ----------------------------

# Google Spreadsheet ID (the long id in the sheet URL)
GOOGLE_SHEET_ID=

# Service account credentials (share the sheet with this email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Multiline private key (Vercel commonly stores this with literal \n sequences)
# Keep the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional: override ranges (tab name + A1 range)
# Voluntary tab default: voluntary!A1:Z
GOOGLE_SHEET_RANGE=voluntary!A1:Z

# Booking tab default: booking!A1:Z
GOOGLE_BOOKING_RANGE=booking!A1:Z
